{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/(hoteles|clientes|reservaciones|comentarios|habitaciones|habitaciones-disponibles)(/.*)?$", "dest": "/index.js" },
    { "src": "^/$", "dest": "/frontend/index.html" },
    { "src": "^/admin$", "dest": "/frontend/admin.html" },
    { "src": "^/(.*)$", "dest": "/frontend/$1" }
  ]
}